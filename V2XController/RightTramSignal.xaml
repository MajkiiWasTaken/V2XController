<UserControl x:Class="V2XController.TramSignalControlRight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40"
             Height="26">

    <Border BorderBrush="#FF1A1A1A"
            BorderThickness="0.5"
            Background="Black"
            CornerRadius="0.5" IsHitTestVisible="False">

        <Canvas Margin="0,0,0,4">
            <!-- Levý indikátor -->
            <Rectangle x:Name="RightIndicator"
                       Canvas.Left="10"
                       Canvas.Top="2"
                       Width="26"
                       Height="6"
                       Fill="#FF1E90FF" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />

            <!-- Rovně indikátor -->
            <Rectangle x:Name="RStraightIndicator"
                       Canvas.Left="2"
                       Canvas.Top="2"
                       Width="6"
                       Height="21"
                       Fill="#FF1E90FF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

            <!-- Oranžový indikátor -->
            <Rectangle x:Name="ROrangeRect"
                       Canvas.Left="10"
                       Canvas.Top="11"
                       Width="26"
                       Height="12"
                       Fill="#FFFF8C00" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />


        </Canvas>

    </Border>
</UserControl>