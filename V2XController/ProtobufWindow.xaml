<Window x:Class="V2XController.ProtobufWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protobuf Message Translator"
        Height="700"
        Width="1400"
        MinWidth="750"
        MinHeight="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        WindowState="Maximized">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header - přes všechny sloupce -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="Protobuf Message Translator" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Add multiple .proto files. Each message type will be automatically detected and used for decoding."
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,0,0,10"/>
        </StackPanel>

        <!-- LEFT COLUMN: Proto Definition + Test Input -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <!-- Proto Definition -->
            <GroupBox Grid.Row="0" Header="Combined Proto Definition (Read-Only)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="#FFFFEB" Padding="5" BorderBrush="#FFCC00" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>

                            <TextBox Grid.Column="1" x:Name="SearchTextBox" 
                         VerticalAlignment="Center"
                         Padding="4"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown"
                         ToolTip="Search in proto definitions (Ctrl+F)"/>

                            <TextBlock Grid.Column="2" x:Name="SearchResultLabel"
                           VerticalAlignment="Center" 
                           Margin="10,0,10,0"
                           Foreground="Gray"
                           FontSize="11"/>

                            <Button Grid.Column="3" Content="▲" 
                        Width="28" Height="24"
                        Click="SearchPrevious_Click" 
                        Margin="0,0,3,0"
                        ToolTip="Previous (Shift+F3)"/>

                            <Button Grid.Column="4" Content="▼" 
                        Width="28" Height="24"
                        Click="SearchNext_Click"
                        ToolTip="Next (F3)"/>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="1" x:Name="CombinedProtoTextBox"
         IsReadOnly="True"
         AcceptsReturn="True"
         TextWrapping="NoWrap"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         FontFamily="Consolas"
         FontSize="11"
         Padding="5"
         Background="#F9F9F9"
         Foreground="#333333"
         SelectionBrush="Orange"
         SelectionTextBrush="Black"
         PreviewKeyDown="CombinedProtoTextBox_KeyDown"/>
                </Grid>
            </GroupBox>

            <!-- Status Bar -->
            <Border Grid.Row="2" 
                    Background="#E0E0E0" 
                    Padding="5"
                    CornerRadius="3">
                <Label x:Name="StatusLabel" 
                       Content="Ready - Add proto files to begin"
                       Foreground="Gray"/>
            </Border>

            <!-- Message Direction Selection -->
            <GroupBox Grid.Row="4" Header="Message Direction and Type">
                <StackPanel>
                    <!-- Radio buttons for direction -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBlock Text="Direction:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <RadioButton x:Name="RsuToControllerRadio" Content="RSU -> Controller" 
                         GroupName="Direction" Margin="0,0,15,0"
                         Checked="MessageDirection_Changed"/>
                        <RadioButton x:Name="ControllerToRsuRadio" Content="Controller -> RSU" 
                         GroupName="Direction" Margin="0,0,15,0"
                         Checked="MessageDirection_Changed"/>
                        <RadioButton x:Name="AllRadio" Content="All (Auto-detect)" 
                         GroupName="Direction" Margin="0,0,15,0"
                         Checked="MessageDirection_Changed" IsChecked="True"/>
                    </StackPanel>

                    <!-- Dropdown for message type -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Message Type:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="MessageTypeComboBox" Width="300" 
                      SelectionChanged="MessageType_Changed">
                            <!-- Items will be populated dynamically based on selected direction -->
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Test Input -->
            <GroupBox Grid.Row="6" Header="Decoder">
                <StackPanel>
                    <TextBlock Text="Hex/Base64 Input:" 
                               Margin="0,0,0,5"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="TestHexTextBox"
                             Height="120"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             Padding="5"
                             Background="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="Decode Test Data" 
                                Click="TestDecode_Click"
                                Padding="10,5"
                                Margin="0,0,5,0"/>
                        <Button Content="Clear" 
                                Click="ClearTest_Click"
                                Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- RIGHT COLUMN: Loaded Files + Decoded Result -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Loaded Files -->
            <GroupBox Grid.Row="0" Header="Loaded Proto Files">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="LoadedFilesPanel" Grid.Row="0" Margin="5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="3" 
                                        Padding="8,5"
                                        Margin="0,2"
                                        Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="📄" 
                                                   FontSize="16"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding MessageSummary}" 
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Status}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontSize="11"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="3" 
                                                Content="✕" 
                                                Width="24"
                                                Height="24"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#F44336"
                                                Cursor="Hand"
                                                ToolTip="Remove this file"
                                                Tag="{Binding FilePath}"
                                                Click="RemoveFile_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="0" 
                               Text="No proto files loaded. Click 'Add Proto File' to begin."
                               Foreground="Gray"
                               FontStyle="Italic"
                               Margin="10"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ElementName=LoadedFilesPanel, Path=HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,5,0,0">
                        <Button Content="Add Proto File(s)" 
                                Click="AddProtoFiles_Click"
                                Padding="10,5"
                                Margin="0,0,5,0"
                                Background="#2196F3"
                                Foreground="White"/>
                        <Button Content="Clear All" 
                                Click="ClearAllFiles_Click"
                                Padding="10,5"
                                Background="#F44336"
                                Foreground="White"/>
                    </StackPanel>
                </Grid>
            </GroupBox>


            <!-- Decoded Result -->
            <GroupBox Grid.Row="2" Header="Decoded Result" FontWeight="Bold">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TestResultTextBox"
                 Grid.Row="0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11"
                 Padding="5"
                 Background="#F9F9F9"
                 Foreground="#333333"/>

                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                       Text="Encode as:" 
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

                        <ComboBox x:Name="OutputFormatComboBox"
                      Grid.Column="1"
                      SelectedIndex="1"
                      Width="100"
                      HorizontalAlignment="Left">
                            <ComboBoxItem Content="Hex"/>
                            <ComboBoxItem Content="Base64"/>
                        </ComboBox>

                        <StackPanel Grid.Column="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                            <Button Content="Encode" 
                        Click="EncodeToHex_Click"
                        Padding="10,5"
                        Margin="0,0,5,0"
                        Background="#4CAF50"
                        Foreground="White"
                        ToolTip="Convert JSON to Hex/Base64 and place in input field"/>
                            <Button Content="Copy" 
                        Click="CopyResult_Click"
                        Padding="10,5"
                        Background="#2196F3"
                        Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>


        <!-- Help Text - přes všechny sloupce -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,5,0,0">
            <TextBlock TextWrapping="Wrap"
                       Foreground="Gray"
                       FontSize="11">
                <Run Text="💡 Tips:"/>
                <LineBreak/>
                <Run Text="• Add multiple .proto files - all message types will be available"/>
                <LineBreak/>
                <Run Text="• Supports both Hexadecimal and Base64 input formats (auto-detected)"/>
                <LineBreak/>
                <Run Text="• Base64 example: SGVsbG8gV29ybGQ="/>
                <LineBreak/>
                <Run Text="• Hex example: 48656C6C6F20576F726C64"/>
                <LineBreak/>
                <Run Text="• The decoder will try all message types and show the best match"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>