<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="PanelBg" Color="#2D2D30"/>
    <SolidColorBrush x:Key="TextFg" Color="White"/>
    <SolidColorBrush x:Key="BorderFg" Color="#5A5A5A"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
    </Style>

    <Style TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
    </Style>

    <Style TargetType="StackPanel">
        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFg}"/>
        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFg}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="#E6E6E6"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#A0A0A0"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderFg}"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="#007ACC"/>
        <Setter Property="Background" Value="#404040"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderFg}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="BorderBrush" Value="#3A3A3A"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                            Width="13"
                            Height="13"
                            Margin="0,0,6,0"
                            Background="{StaticResource PanelBg}"
                            BorderBrush="{StaticResource BorderFg}"
                            BorderThickness="1">
                            <TextBlock x:Name="CheckMark"
                                   Text="✓"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        </Border>

                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="Background" Value="#007ACC"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Circle"
                            Width="13"
                            Height="13"
                            CornerRadius="7"
                            Margin="0,0,6,0"
                            Background="{StaticResource PanelBg}"
                            BorderBrush="{StaticResource BorderFg}"
                            BorderThickness="1">
                            <Ellipse x:Name="Dot"
                                 Width="7"
                                 Height="7"
                                 Fill="White"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                        </Border>

                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Circle" Property="Background" Value="#007ACC"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
        <Setter Property="RowBackground" Value="{StaticResource PanelBg}"/>
        <Setter Property="AlternatingRowBackground" Value="#252525"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="Foreground" Value="{StaticResource TextFg}"/>
    </Style>

</ResourceDictionary>