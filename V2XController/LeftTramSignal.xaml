<UserControl x:Class="V2XController.TramSignalControlLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40"
             Height="26">

    <Border BorderBrush="#FF1A1A1A"
            BorderThickness="0.5"
            Background="Black"
            CornerRadius="0.5">

        <Canvas Margin="0.5">
            <!-- Levý indikátor -->
            <Rectangle x:Name="LeftIndicator"
                       Canvas.Left="2"
                       Canvas.Top="2"
                       Width="26"
                       Height="6"
                       Fill="#FF1E90FF" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Rovně indikátor -->
            <Rectangle x:Name="LStraightIndicator"
                       Canvas.Left="30"
                       Canvas.Top="2"
                       Width="6"
                       Height="21"
                       Fill="#FF1E90FF" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Oranžový indikátor -->
            <Rectangle x:Name="LOrangeRect"
                       Canvas.Left="2"
                       Canvas.Top="11"
                       Width="26"
                       Height="12"
                       Fill="#FFFF8C00" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Canvas>

    </Border>
</UserControl>