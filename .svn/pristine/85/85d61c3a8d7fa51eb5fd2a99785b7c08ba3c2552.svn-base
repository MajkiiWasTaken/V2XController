using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Xml;

namespace V2XController
{
    internal class V2XMessageParser
    {
        public static string GetMessageType(string rawXml)
        {
            if (rawXml.Contains("<CAM>")) return "CAM";
            if (rawXml.Contains("<SRV>")) return "SRV";
            return "UNKNOWN";
        }

        public static V2XMessage ParseV2XMessage(string rawXml)
        {
            var xmlDoc = new XmlDocument();
            xmlDoc.LoadXml(rawXml);

            var msg = new V2XMessage();
            msg.MessageType = GetMessageType(rawXml);

            var vehPtNode = xmlDoc.SelectSingleNode("//vehPt");

            string fullStatId = vehPtNode?.Attributes["statId"]?.Value ?? "";
            if (fullStatId.Length >= 4)
                msg.VehicleID = fullStatId.Substring(fullStatId.Length - 4);
            else
                msg.VehicleID = fullStatId;

            if (double.TryParse(vehPtNode?.Attributes["dist"]?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double dist))
                msg.DistanceMeters = dist;

            if (double.TryParse(vehPtNode?.Attributes["lat"]?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double lat))
                msg.Latitude = lat;

            if (double.TryParse(vehPtNode?.Attributes["lng"]?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double lon))
                msg.Longitude = lon;

            if (double.TryParse(vehPtNode?.Attributes["speed"]?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double speed))
                msg.Speed = speed;

            if (double.TryParse(vehPtNode?.Attributes["heading"]?.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double heading))
                msg.Heading = heading;

            if (DateTime.TryParse(vehPtNode?.Attributes["lastRec"]?.Value, out DateTime ts))
                msg.Timestamp = ts;
            else
                msg.Timestamp = DateTime.Now;

            return msg;
        }


        public static List<V2XMessage> LoadMessagesFromCSV(string path)
        {
            var messages = new List<V2XMessage>();

            foreach (var line in File.ReadLines(path).Skip(1))
            {
                var parts = line.Split(',');
                if (parts.Length < 6) continue;

                messages.Add(new V2XMessage
                {
                    VehicleID = parts[0],
                    Timestamp = DateTime.Parse(parts[1]),
                    Latitude = double.Parse(parts[2]),
                    Longitude = double.Parse(parts[3]),
                    Speed = double.Parse(parts[4]),
                    Heading = double.Parse(parts[5]),
                    MessageType = "CSV"
                });
            }

            return messages;
        }
    }
}
