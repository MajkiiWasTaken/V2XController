        private void PlaybackSlider_ValueChanged(object sender, RoutedPropertyChangedEventArgs<double> e)
        {
            if (!isSliderDragging && isPlaying)
            {
                playbackElapsedTime = TimeSpan.FromSeconds(PlaybackSlider.Value);
                playbackStartTime = DateTime.Now - TimeSpan.FromTicks((long)(playbackElapsedTime.Ticks / playbackSpeedFactor));

                RedrawPlaybackToTime(playbackElapsedTime);
            }
        }

        private void PlaybackSlider_DragStarted(object sender, System.Windows.Controls.Primitives.DragStartedEventArgs e)
        {
            isSliderDragging = true;
            wasPlayingBeforeSliderDrag = isPlaying && playbackTimer != null && playbackTimer.IsEnabled;
            if (playbackTimer != null)
                playbackTimer.Stop();
        }

        private void PlaybackSlider_DragCompleted(object sender, System.Windows.Controls.Primitives.DragCompletedEventArgs e)
        {
            isSliderDragging = false;
            playbackElapsedTime = TimeSpan.FromSeconds(PlaybackSlider.Value);
            playbackStartTime = DateTime.Now - TimeSpan.FromTicks((long)(playbackElapsedTime.Ticks / playbackSpeedFactor));
            RedrawPlaybackToTime(playbackElapsedTime);

            // Only resume if it was playing before the drag
            if (wasPlayingBeforeSliderDrag && isPlaying && playbackTimer != null)
                playbackTimer.Start();
        }

        private void RedrawPlaybackToTime(TimeSpan time)
        {
            playbackElapsedTime = time;

            foreach (var pt in points)
            {
                if (pt.MovementFrames.Count == 0) continue;

                var nextFrame = pt.MovementFrames.FirstOrDefault(f => f.Timestamp > time);

                if (nextFrame == null)
                {
                    var last = pt.MovementFrames.Last();
                    UpdatePointPosition(pt, last.Position);
                    CheckActivationZones(last.Position, pt.Label);
                    continue;
                }

                var prevFrame = pt.MovementFrames.LastOrDefault(f => f.Timestamp <= time);

                if (prevFrame != null)
                {
                    double progress = (time - prevFrame.Timestamp).TotalMilliseconds /
                                      (nextFrame.Timestamp - prevFrame.Timestamp).TotalMilliseconds;

                    var interpolated = new Point(
                        Lerp(prevFrame.Position.X, nextFrame.Position.X, progress),
                        Lerp(prevFrame.Position.Y, nextFrame.Position.Y, progress)
                    );

                    UpdatePointPosition(pt, interpolated);
                    CheckActivationZones(interpolated, pt.Label);
                }
            }

            for (int idx = 0; idx < drawnTrams.Length; idx++)
            {
                var tram = drawnTrams[idx];
                if (tram == null || tram.MovementFrames == null || tram.MovementFrames.Count == 0) continue;

                MovementFrame prevFrame = null, nextFrame = null;
                foreach (var frame in tram.MovementFrames)
                {
                    if (frame.Timestamp > time)
                    {
                        nextFrame = frame;
                        break;
                    }
                    prevFrame = frame;
                }

                Point pos;
                if (nextFrame == null && prevFrame != null)
                {
                    pos = prevFrame.Position;
                }
                else if (prevFrame != null && nextFrame != null)
                {
                    double progress = (time - prevFrame.Timestamp).TotalMilliseconds /
                                      (nextFrame.Timestamp - prevFrame.Timestamp).TotalMilliseconds;
                    pos = new Point(
                        Lerp(prevFrame.Position.X, nextFrame.Position.X, progress),
                        Lerp(prevFrame.Position.Y, nextFrame.Position.Y, progress)
                    );
                }
                else
                {
                    continue;
                }

                if (tram.Ellipse != null) TileCanvas.Children.Remove(tram.Ellipse);
                if (tram.Text != null) TileCanvas.Children.Remove(tram.Text);
                if (drawnTramTrails[idx] != null) TileCanvas.Children.Remove(drawnTramTrails[idx]);
                if (tram.TrailDots != null)
                {
                    foreach (var dot in tram.TrailDots)
                        TileCanvas.Children.Remove(dot);
                    tram.TrailDots.Clear();
                }
                else
                {
                    tram.TrailDots = new List<Ellipse>();
                }

                var ellipse = new Ellipse
                {
                    Width = 12,
                    Height = 12,
                    Fill = drawnTramColors[idx],
                    Stroke = Brushes.Black,
                    StrokeThickness = 1,
                    IsHitTestVisible = false
                };
                Canvas.SetLeft(ellipse, pos.X - 6);
                Canvas.SetTop(ellipse, pos.Y - 6);
                TileCanvas.Children.Add(ellipse);

                var text = new TextBlock
                {
                    Text = tram.Label?.Length > 4 ? tram.Label[^4..] : tram.Label,
                    Foreground = drawnTramColors[idx],
                    FontWeight = FontWeights.Bold,
                    FontSize = 12,
                    IsHitTestVisible = false
                };
                Canvas.SetLeft(text, pos.X + 5);
                Canvas.SetTop(text, pos.Y - 10);
                TileCanvas.Children.Add(text);

                var trail = new Polyline
                {
                    Stroke = drawnTramColors[idx],
                    StrokeThickness = 2,
                    IsHitTestVisible = false
                };
                var playedFrames = tram.MovementFrames.Where(f => f.Timestamp <= time).ToList();
                foreach (var frame in playedFrames)
                    trail.Points.Add(frame.Position);
                TileCanvas.Children.Add(trail);

                for (int i = 0; i < playedFrames.Count - 1; i++)
                {
                    var dotPos = playedFrames[i].Position;
                    var dot = new Ellipse { Width = 5, Height = 5, Fill = Brushes.Black, IsHitTestVisible = false };
                    Canvas.SetLeft(dot, dotPos.X - 2.5);
                    Canvas.SetTop(dot, dotPos.Y - 2.5);
                    TileCanvas.Children.Add(dot);
                    tram.TrailDots.Add(dot);
                    Panel.SetZIndex(dot, 1001);
                }

                tram.Ellipse = ellipse;
                tram.Text = text;
                drawnTramTrails[idx] = trail;

                CheckActivationZones(pos, tram.Label);

                // keep it alive during scrubbing
                tram.LastUpdate = DateTime.Now;
            }

            bool allPointsDone = points.All(p => time > p.MovementFrames.LastOrDefault()?.Timestamp);
            bool allTramsDone = drawnTrams.All(tram => tram == null || time > tram.MovementFrames.LastOrDefault()?.Timestamp);

            if (allPointsDone && allTramsDone)
            {
                playbackTimer?.Stop();
                isPlaying = false;
            }

            if (!isSliderDragging)
            {
                PlaybackSlider.Value = Math.Min(time.TotalSeconds, playbackMaxTime.TotalSeconds);
            }
        }

        private TimeSpan GetPlaybackMaxTime()
        {
            var max = TimeSpan.Zero;
            foreach (var pt in points)
                if (pt.MovementFrames.Count > 0)
                    max = TimeSpan.FromTicks(Math.Max(max.Ticks, pt.MovementFrames.Last().Timestamp.Ticks));
            foreach (var tram in drawnTrams)
                if (tram != null && tram.MovementFrames != null && tram.MovementFrames.Count > 0)
                    max = TimeSpan.FromTicks(Math.Max(max.Ticks, tram.MovementFrames.Last().Timestamp.Ticks));
            return max;
        }

