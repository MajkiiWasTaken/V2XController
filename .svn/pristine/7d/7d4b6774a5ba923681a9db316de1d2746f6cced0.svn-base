        //WPF Component methods

        private void RadioButton_Checked(object sender, RoutedEventArgs e)
        {
            if (Tram.IsChecked == true)
            {
                RecordsView.Filter = item => (item as Table)?.Type == "tram";
                RecordsView.Refresh();
            }
            else if (Trol.IsChecked == true)
            {
                RecordsView.Filter = item => (item as Table)?.Type == "trol";
                RecordsView.Refresh();
            }
            else if (All.IsChecked == true)
            {
                RecordsView.Filter = null;
                RecordsView.Refresh();
            }
        }

