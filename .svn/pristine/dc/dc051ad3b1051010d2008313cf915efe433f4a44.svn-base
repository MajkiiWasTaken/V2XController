<Window x:Class="V2XController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:V2XController"
        mc:Ignorable="d"
        Title="V2X Controller" Height="900" Width="1600"
        MouseWheel="Window_MouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.DirectionalNavigation="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">


    <Grid>
        <Grid>

            <DataGrid x:Name="TramTable"
              AutoGenerateColumns="True"
              Margin="34,569,816,131"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto"
              ScrollViewer.CanContentScroll="True"
              SelectionChanged="TramTable_SelectionChanged" 
              Visibility="Hidden"/>

            <TabControl Margin="34,573,1334,31">
                <TabItem Header="Activation zones">
                    <StackPanel Margin="10">
                        <TextBlock Text="Width:" FontWeight="Bold"/>
                        <TextBlock x:Name="WidthText" />

                        <TextBlock Text="Height:" FontWeight="Bold"/>
                        <TextBlock x:Name="HeightText" />

                        <TextBlock Text="Last tram ID:" FontWeight="Bold"/>
                        <TextBlock x:Name="LastTramIdText"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Basic information">
                    <StackPanel Margin="10">
                        <TextBlock Text="StatId:" FontWeight="Bold" />
                        <TextBlock x:Name="StatIdText" />

                        <TextBlock Text="Type:" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock x:Name="TypeText" />

                        <TextBlock Text="Latitude:" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock x:Name="LatText" />

                        <TextBlock Text="Longitude:" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock x:Name="LonText" />

                        <TextBlock Text="Speed:" FontWeight="Bold" Margin="0,10,0,0" />
                        <TextBlock x:Name="SpeedText" />
                    </StackPanel>
                </TabItem>
            </TabControl>
            <Label x:Name="CamOkLabel" Content="CAM OK: 0" HorizontalAlignment="Left" Height="27" Margin="354,583,0,0" VerticalAlignment="Top" Width="196"/>
            <Label x:Name="CamIdLabel" Content="CAM ID: 0" HorizontalAlignment="Left" Height="27" Margin="354,637,0,0" VerticalAlignment="Top" Width="196"/>
            <Label x:Name="LastCamLabel" Content="Last CAM: --:--:--" HorizontalAlignment="Left" Height="27" Margin="354,664,0,0" VerticalAlignment="Top" Width="196"/>
            <Label x:Name="SrvOkLabel" Content="SRV OK: 0" HorizontalAlignment="Left" Height="27" Margin="555,583,0,0" VerticalAlignment="Top" Width="245"/>
            <Label x:Name="CamErrorLabel" Content="CAM Error: 0" HorizontalAlignment="Left" Height="27" Margin="354,610,0,0" VerticalAlignment="Top" Width="196"/>
        </Grid>


        <Border BorderBrush="Black" BorderThickness="1" Margin="84,205,800,420"/>

        <Canvas x:Name="TileCanvas"
                Width="694" Height="694"
                ClipToBounds="True"
                Background="Transparent"
                MouseLeftButtonDown="TileCanvas_MouseLeftButtonDown"
                MouseMove="TileCanvas_MouseMove"
                MouseLeftButtonUp="TileCanvas_MouseLeftButtonUp"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" Margin="835,0,0,0"/>

        <ComboBox x:Name="StrokeColorBox"
                    Width="120"
                    Height="30"
                    Margin="96,262,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    SelectionChanged="StrokeColorBox_SelectionChanged">
            <ComboBoxItem Content="Red" />
            <ComboBoxItem Content="Green" />
            <ComboBoxItem Content="Blue" />
            <ComboBoxItem Content="Black" />
            <ComboBoxItem Content="Orange" />
        </ComboBox>
        <Label Content="Color of the rectangle" Margin="93,231,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Button Content="Save all table lines" Click="ExportButton_Click" HorizontalAlignment="Left" Margin="34,829,0,0" VerticalAlignment="Top" Visibility="Hidden"/>
        <TextBox x:Name="LatitudeBox" HorizontalAlignment="Left" Height="28" Margin="45,477,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="228" TextChanged="LatitudeBox_TextChanged"/>
        <TextBox x:Name="LongitudeBox" HorizontalAlignment="Left" Height="29" Margin="45,532,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="228" TextChanged="LongitudeBox_TextChanged"/>
        <Label Content="Latitude" FontWeight="Bold" HorizontalAlignment="Left" Height="23" Margin="45,454,0,0" VerticalAlignment="Top" Width="111"/>
        <Label Content="Longitude" FontWeight="Bold" HorizontalAlignment="Left" Height="27" Margin="45,505,0,0" VerticalAlignment="Top" Width="111"/>
        <Button x:Name="rectButton" Content="Rectangle" HorizontalAlignment="Left" Height="48" Margin="250,237,0,0" VerticalAlignment="Top" Width="96" Click="rectButton_Click" RenderTransformOrigin="0.495,0.553"/>
        <Button x:Name="StopDrawing" Content="Stop Drawing" HorizontalAlignment="Left" Height="48" Margin="250,304,0,0" VerticalAlignment="Top" Width="96" Click="StopDrawing_Click" RenderTransformOrigin="0.495,0.553"/>
        <Button x:Name="RailwayButton"  Content="Railway" HorizontalAlignment="Left" Height="48" Margin="378,238,0,0" VerticalAlignment="Top" Width="96" Click="RailwayButton_Click" RenderTransformOrigin="0.495,0.553"/>
        <Button x:Name="DrawPoints" Content="Draw points" HorizontalAlignment="Left" Height="48" Margin="378,304,0,0" VerticalAlignment="Top" Width="96" Click="DrawPoints_Click" RenderTransformOrigin="0.495,0.553"/>
        <Slider x:Name="SliderPoints" Margin="96,378,1328,462" Minimum="0" Maximum="10" ValueChanged="SliderPoints_ValueChanged"/>
        <Label Content="Map" FontWeight="Bold" HorizontalAlignment="Left" Height="43" Margin="835,54,0,0" VerticalAlignment="Top" Width="110"/>
        <Label Content="Point rollback" HorizontalAlignment="Left" Height="43" Margin="282,373,0,0" VerticalAlignment="Top" Width="110"/>
        <TextBox Name="DebugTextBox" 
                 VerticalScrollBarVisibility="Auto" 
                 HorizontalScrollBarVisibility="Auto" 
                 IsReadOnly="True" AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 Margin="337,30,800,665"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="816,47,32,60"/>
        <Button x:Name="btnRefreshMap" Content="Refresh map" Margin="816,810,554,10" Click="RefreshMap_Click"/>
        <Button x:Name="btnExportMap" Content="Export map into an image" Margin="1067,810,303,10" Click="ExportMap_Click"/>
        <Button x:Name="SaveToXML" Content="Save To XML" HorizontalAlignment="Left" Height="48" Margin="354,454,0,0" VerticalAlignment="Top" Width="139" Click="SaveToXML_Click"/>
        <Button x:Name="LoadFromXML" Content="Load From XML" HorizontalAlignment="Left" Height="48" Margin="499,454,0,0" VerticalAlignment="Top" Width="139" Click="LoadFromXML_Click"/>
        <Button x:Name="btnStartRecording" Content="Record movement" HorizontalAlignment="Left" Height="48" Margin="354,509,0,0" VerticalAlignment="Top" Width="139" Click="btnRecordMovement_Click"/>
        <Button x:Name="PlayMovement" Content="Play movement" HorizontalAlignment="Left" Height="48" Margin="645,509,0,0" VerticalAlignment="Top" Width="139" Click="PlayMovement_Click"/>
        <Button x:Name="btnStopRecording" Content="Stop recording" HorizontalAlignment="Left" Height="48" Margin="499,509,0,0" VerticalAlignment="Top" Width="139" Click="btnStopRecording_Click"/>
        <Button Content="Connect"
        Click="Connect_Click"
        Width="100"
        Margin="84,30,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Top" Height="37" FontWeight="Bold" FontSize="18"/>
        <StackPanel x:Name="PropertiesPanel" Background="LightGray" Height="205" Margin="499,224,816,0" VerticalAlignment="Top">
            <TextBlock Text="Properties" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="Name:" />
            <TextBox x:Name="Prop_Name" TextChanged="Prop_Name_TextChanged"/>

            <TextBlock Text="Width:" Margin="0,10,0,0"/>
            <TextBox x:Name="Prop_Width" TextChanged="Prop_Width_TextChanged" KeyDown="Prop_Width_KeyDown"/>

            <TextBlock Text="Height:"/>
            <TextBox x:Name="Prop_Height" TextChanged="Prop_Height_TextChanged" KeyDown="Prop_Height_KeyDown"/>

            <TextBlock Text="Color:" Margin="0,10,0,0"/>
            <ComboBox x:Name="Prop_Color" SelectionChanged="Prop_Color_Changed">
                <ComboBoxItem Content="Red"/>
                <ComboBoxItem Content="Green"/>
                <ComboBoxItem Content="Blue"/>
                <ComboBoxItem Content="Black"/>
            </ComboBox>
        </StackPanel>
        <Button x:Name="MapControls" Content="Map controls" HorizontalAlignment="Left" Height="64" Margin="1459,810,0,0" VerticalAlignment="Top" Width="93" Click="MapControls_Click"/>
        <Button Content="Disconnect"
            Click="Disconnect_Click"
            Width="100"
            Margin="212,30,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" Height="37" FontWeight="Bold" FontSize="18"/>
        <TextBox x:Name="PortTB" HorizontalAlignment="Left" Height="28" Margin="84,111,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="75" TextChanged="PortTB_TextChanged"/>
        <TextBox x:Name="BaudrateTB" HorizontalAlignment="Left" Height="28" Margin="212,111,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="75" TextChanged="BaudrateTB_TextChanged"/>
        <Label Content="Port" FontWeight="Bold" HorizontalAlignment="Left" Height="23" Margin="84,88,0,0" VerticalAlignment="Top" Width="111"/>
        <Label Content="Baudrate" FontWeight="Bold" HorizontalAlignment="Left" Height="23" Margin="212,88,0,0" VerticalAlignment="Top" Width="111"/>


    </Grid>
</Window>
<!--ItemsSource="{Binding Records}"-->