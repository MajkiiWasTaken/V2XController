        //calculating tile location
        private static (int tileX, int tileY) LatLonToTileXY(double lat, double lon, int zoom)
        {
            int tileX = (int)Math.Floor((lon + 180.0) / 360.0 * (1 << zoom));
            double latRad = lat * Math.PI / 180.0;
            int tileY = (int)Math.Floor(
                (1.0 - Math.Log(Math.Tan(latRad) + 1.0 / Math.Cos(latRad)) / Math.PI) / 2.0 * (1 << zoom)
            );
            return (tileX, tileY);
        }

        //Position on the map
        private (double x, double y) ConvertLatLonToCanvasXY(double lat, double lon)
        {
            var (tileX, tileY) = LatLonToTileXY(lat, lon, zoom);

            int pixelX = (int)((lon + 180.0) / 360.0 * (1 << zoom) * TilePixelSize);
            double latRad = lat * Math.PI / 180.0;
            int pixelY = (int)((1.0 - Math.Log(Math.Tan(latRad) + 1.0 / Math.Cos(latRad)) / Math.PI) / 2.0 * (1 << zoom) * TilePixelSize);

            var (startTileX, startTileY) = LatLonToTileXY(latitude, longitude, zoom); // anchor tiles
            int anchorPixelX = startTileX * TilePixelSize;
            int anchorPixelY = startTileY * TilePixelSize;

            double offsetX = pixelX - anchorPixelX;
            double offsetY = pixelY - anchorPixelY;

            return (offsetX, offsetY);
        }


        //Loading map tiles on the grid
        private async Task LoadTiles(int startX, int startY)
        {
            TileCanvas.Children
                .OfType<Image>()
                .ToList()
                .ForEach(img => TileCanvas.Children.Remove(img));

            isDrawing = false;
            currentRect = null;
            _currentMapRectangle = null;

            using HttpClient client = new HttpClient();
            client.DefaultRequestHeaders.UserAgent.Clear();
            client.DefaultRequestHeaders.UserAgent.ParseAdd("V2XController/1.0 (Michal.Svrcek@hrosistavby.cz)"); //needed for authorization => without it I couldn't download tiles 

            for (int x = 0; x < TileCount; x++)
            {
                for (int y = 0; y < TileCount; y++)
                {
                    int tileX = startX + x;
                    int tileY = startY + y;
                    string url = $"https://tile.openstreetmap.org/{zoom}/{tileX}/{tileY}.png"; //URL for tiles

                    try
                    {
                        byte[] data = await client.GetByteArrayAsync(url);
                        BitmapImage bitmap = new BitmapImage();
                        bitmap.BeginInit();
                        bitmap.StreamSource = new MemoryStream(data);
                        bitmap.DecodePixelWidth = TilePixelSize;
                        bitmap.DecodePixelHeight = TilePixelSize;
                        bitmap.EndInit();

                        Image image = new Image
                        {
                            Width = TilePixelSize,
                            Height = TilePixelSize,
                            Source = bitmap
                        };

                        Canvas.SetLeft(image, x * TilePixelSize);
                        Canvas.SetTop(image, y * TilePixelSize);
                        TileCanvas.Children.Add(image);

                        await Task.Delay(200);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error while loading {url}: {ex.Message}");
                    }
                }
            }

            if (!TileCanvas.Children.Contains(connectionLine)) TileCanvas.Children.Add(connectionLine);

            foreach (var pt in points)
            {
                if (!TileCanvas.Children.Contains(pt.Ellipse))
                    TileCanvas.Children.Add(pt.Ellipse);

                if (!TileCanvas.Children.Contains(pt.Text))
                    TileCanvas.Children.Add(pt.Text);
            }
        }

        private void TileCanvas_MouseWheel(object sender, MouseWheelEventArgs e) { }

        //zooming on the map
        private void Window_MouseWheel(object sender, MouseWheelEventArgs e)
        {
            int delta = e.Delta > 0 ? 1 : -1;
            int newZoom = zoom + delta;

            if (newZoom < 1 || newZoom >= 19) return;

            zoom = newZoom;
            var (startX, startY) = LatLonToTileXY(latitude, longitude, zoom);
            _ = LoadTiles(startX, startY);
        }

        private void TileCanvas_PreviewMouseDown(object sender, MouseButtonEventArgs e)
        {
            if (e.ChangedButton == MouseButton.Middle)
            {
                middleMousePanStart = e.GetPosition(this);
                isMiddleMousePanning = true;
                isPanning = true;
                TileCanvas.CaptureMouse();
                e.Handled = true;
            }
        }

        private void TileCanvas_PreviewMouseUp(object sender, MouseButtonEventArgs e)
        {
            if (e.ChangedButton == MouseButton.Middle)
            {
                isMiddleMousePanning = false;
                TileCanvas.ReleaseMouseCapture();
                isPanning = false;

                var (startX, startY) = LatLonToTileXY(latitude, longitude, zoom);
                _ = LoadTiles(startX, startY);
                e.Handled = true;
            }
        }

        private void TileCanvas_MouseMove_MiddlePan(object sender, MouseEventArgs e)
        {
            if (!isMiddleMousePanning) return;

            Point current = e.GetPosition(this);
            Vector delta = current - middleMousePanStart;
            middleMousePanStart = current;

            double lonDelta = -delta.X / TilePixelSize * 360.0 / (1 << zoom);
            double latDelta = delta.Y / TilePixelSize * 170.1022 / (1 << zoom); 

            latitude += latDelta;
            longitude += lonDelta;

            latitude = Math.Max(-85, Math.Min(85, latitude));
            longitude = (longitude + 180) % 360 - 180;

            e.Handled = true;
        }


        private void ExportToCSV(string filePath)
        {
            var csvLines = new List<string>();
            csvLines.Add("StatID,Type,Latitude,Longitude,Alt,Speed,Azimuth,LastRec,Dist,LineNum,VehNum,Embarkation");

            foreach (var row in Records)
            {
                string line = $"{row.StatId},{row.Type},{row.Latitude},{row.Longitude},{row.Alt},{row.Speed},{row.Azimuth},{row.LastRec},{row.Dist},{row.LineNum},{row.VehNum},{row.Embarkation}";
                csvLines.Add(line);
            }

            File.WriteAllLines(filePath, csvLines);
        }

        //Loading data from CSV
        private void LoadFromCSV(string filePath)
        {
            if (!File.Exists(filePath))
            {
                MessageBox.Show("File not found.");
            }

            try
            {
                using var reader = new StreamReader(filePath);
                string? line;
                bool firstline = true;

                while ((line = reader.ReadLine()) != null)
                {
                    if (firstline)
                    {
                        firstline = false;
                        continue;
                    }

                    var parts = line.Split(',');
                    if (parts.Length < 12) continue;

                    Records.Add(new Table
                    {
                        StatId = parts[0],
                        Type = parts[1],
                        Latitude = parts[2],
                        Longitude = parts[3],
                        Alt = parts[4],
                        Speed = parts[5],
                        Azimuth = parts[6],
                        LastRec = parts[7],
                        Dist = parts[8],
                        LineNum = parts[9],
                        VehNum = parts[10],
                        Embarkation = parts[11]
                    });
                }
            }
            catch
            {
                MessageBox.Show("File is empty");
            }
        }

        //method for map refreshing
        private void RefreshMap()
        {
            var (startX, startY) = LatLonToTileXY(Mapsettings.Latitude, Mapsettings.Longitude, zoom);
            _ = LoadTiles(startX, startY);
        }

        //Meters per px
        private double MetersPerPixel(double latitude, int zoom)
        {
            double earthCircumference = 40075016.686; // in meters
            double latitudeRad = latitude * Math.PI / 180.0;
            return earthCircumference * Math.Cos(latitudeRad) / Math.Pow(2, zoom + 8); // +8 because of 256 px
        }

        private UIElement GetParentElementInCanvas(UIElement element)
        {
            while (element != null && !TileCanvas.Children.Contains(element))
            {
                element = VisualTreeHelper.GetParent(element) as UIElement;
            }
            return element;
        }


        //adding drawing on the map
        private void TileCanvas_MouseLeftButtonDown(object sender, MouseButtonEventArgs e)
        {
            if (isSelectionMode)
            {
                var clicked = e.OriginalSource as UIElement;
                var element = GetParentElementInCanvas(clicked);

                if (element != null)
                {
                    SelectElement(element);
                }
                else
                {
                    DeselectElement();
                }

                return;
            }
            else
            {
                
                isDrawing = true;
                startPoint = e.GetPosition(TileCanvas);

                if (currentDrawingMode == DrawingMode.Rectangle) // rectangle button
                {
                    currentRect = new Rectangle
                    {
                        Stroke = _strokeBrush,
                        StrokeThickness = 2,
                        Fill = Brushes.Transparent
                    };
                    currentRect.MouseEnter += Rectangle_MouseEnter;
                    currentRect.MouseLeave += Rectangle_MouseLeave;
                        
                    Canvas.SetLeft(currentRect, startPoint.X);
                    Canvas.SetTop(currentRect, startPoint.Y);
                    TileCanvas.Children.Add(currentRect);

                    _currentMapRectangle = new MapRectangle(currentRect);

                    currentRect.MouseLeftButtonDown += Rectangle_MouseLeftButtonDown;
                }
                else if (currentDrawingMode == DrawingMode.Railway) // railway button
                {
                    currentLine = new Line
                    {
                        Stroke = Brushes.Black,
                        StrokeThickness = 2,
                        X1 = startPoint.X,
                        Y1 = startPoint.Y,
                        X2 = startPoint.X,
                        Y2 = startPoint.Y
                    };

                    TileCanvas.Children.Add(currentLine);
                }
                else if (currentDrawingMode == DrawingMode.Point) // point button
                {
                    if (points.Count > 0 && ArePointsClose(startPoint, points.Last().Position))
                    {
                        return;
                    }

                    var ellipse = new Ellipse
                    {
                        Width = 10,
                        Height = 10,
                        Fill = Brushes.Black
                    };

                    Canvas.SetLeft(ellipse, startPoint.X - 5);
                    Canvas.SetTop(ellipse, startPoint.Y - 5);

                    var text = new TextBlock
                    {
                        Text = $"Point {pointCounter}",
                        Foreground = Brushes.Black,
                        FontWeight = FontWeights.Bold,
                        FontSize = 12
                    };

                    Canvas.SetLeft(text, startPoint.X + 5);
                    Canvas.SetTop(text, startPoint.Y - 10);

                    TileCanvas.Children.Add(ellipse);
                    TileCanvas.Children.Add(text);

                    var newPoint = new MapPoint
                    {
                        Position = startPoint,
                        Label = $"Point {pointCounter}",
                        Ellipse = ellipse,
                        Text = text
                    };

                    points.Add(newPoint);
                    connectionLine.Points.Add(startPoint);

                    Panel.SetZIndex(connectionLine, 100);

                    pointCounter++;

                    SliderPoints.Maximum = points.Count;
                    SliderPoints.Value = points.Count;
                }
            }
        }

        //LMB drawing
        private void TileCanvas_MouseMove(object sender, MouseEventArgs e)
        {
            if (!isDrawing) return;

            var pos = e.GetPosition(TileCanvas);

            if (currentDrawingMode == DrawingMode.Rectangle && currentRect != null)
            {
                double widthPx = Math.Abs(pos.X - startPoint.X);
                double heightPx = Math.Abs(pos.Y - startPoint.Y);

                Point snappedPos = pos;
                var snap = GetSnapPosition(pos);
                if (snap.HasValue) snappedPos = snap.Value;

                currentRect.Width = widthPx;
                currentRect.Height = heightPx;

                Canvas.SetLeft(currentRect, Math.Min(pos.X, startPoint.X));
                Canvas.SetTop(currentRect, Math.Min(pos.Y, startPoint.Y));

                double mpp = MetersPerPixel(latitude, zoom);
                double widthMeters = widthPx * mpp;
                double heightMeters = heightPx * mpp;

                dimensionTextBlock.Text = $"{widthMeters:F1} m × {heightMeters:F1} m";
                Canvas.SetLeft(dimensionTextBlock, pos.X + 10);
                Canvas.SetTop(dimensionTextBlock, pos.Y + 10);
                dimensionTextBlock.Visibility = Visibility.Visible;
            }
            else if (currentDrawingMode == DrawingMode.Railway && currentLine != null)
            {
                currentLine.X2 = pos.X;
                currentLine.Y2 = pos.Y;
            }
        }

        private void TileCanvas_MouseLeftButtonUp(object sender, MouseButtonEventArgs e)
        {
            if (!isDrawing) return;
            isDrawing = false;

            if (currentDrawingMode == DrawingMode.Rectangle && _currentMapRectangle != null && currentRect != null)
            {
                double left = Canvas.GetLeft(currentRect);
                double top = Canvas.GetTop(currentRect);

                _currentMapRectangle.X = left;
                _currentMapRectangle.Y = top;
                _currentMapRectangle.Width = currentRect.Width;
                _currentMapRectangle.Height = currentRect.Height;
                _currentMapRectangle.ContainsSomething = true;
                _currentMapRectangle.Name = "Something";
                _currentMapRectangle.Description = "This rectangle contains something";

                mapRectangles.Add(_currentMapRectangle);

                Prop_Name.Text = _currentMapRectangle.Name;
                Prop_Width.Text = _currentMapRectangle.Width.ToString("0");
                Prop_Height.Text = _currentMapRectangle.Height.ToString("0");

                AddUndoRedo(
                    undo: () =>
                    {
                        TileCanvas.Children.Remove(currentRect);
                        mapRectangles.Remove(_currentMapRectangle);
                    },
                    redo: () =>
                    {
                        TileCanvas.Children.Add(currentRect);
                        mapRectangles.Add(_currentMapRectangle);

                        Prop_Name.Text = _currentMapRectangle.Name;
                        Prop_Width.Text = _currentMapRectangle.Width.ToString("0");
                        Prop_Height.Text = _currentMapRectangle.Height.ToString("0");
                    });
            }

            currentRect = null;
            _currentMapRectangle = null;
            currentLine = null;
            dimensionTextBlock.Visibility = Visibility.Collapsed;
        }


        //Keystrokes (esc, arrows, etc.)
        private void Window_PreviewKeyDown(object sender, KeyEventArgs e)
        {
            Console.WriteLine($"Key pressed: {e.Key}");

            //exit
            if (e.Key == Key.Escape)
            {
                Application.Current.Shutdown();
                e.Handled = true;
                return;
            }

            //undo
            if (e.Key == Key.Z && Keyboard.Modifiers.HasFlag(ModifierKeys.Control)) 
            {
                Undo();
                e.Handled = true;
                return;
            }

            //redo
            if (e.Key == Key.Y && Keyboard.Modifiers.HasFlag(ModifierKeys.Control))
            {
                Redo();
                e.Handled = true;
                return;
            }

            //object rotation
            if (currentRect != null && (e.Key == Key.Left || e.Key == Key.Right))
            {
                double currentAngle = 0;

                if (currentRect.RenderTransform is RotateTransform rt)
                    currentAngle = rt.Angle;

                if (e.Key == Key.Left)
                {
                    currentAngle -= 5;
                }
                else if (e.Key == Key.Right)
                {
                    currentAngle += 5;
                }

                currentRect.RenderTransform = new RotateTransform(currentAngle);
                currentRect.RenderTransformOrigin = new Point(0.5, 0.5);
                e.Handled = true;
                return;
            }

            //deletion
            if (e.Key == Key.Delete && selectedElement != null)
            {
                TileCanvas.Children.Remove(selectedElement);

                if (selectedElement is Ellipse ellipse)
                {
                    var pointToRemove = points.FirstOrDefault(p => p.Ellipse == ellipse);
                    if (pointToRemove != null)
                    {
                        TileCanvas.Children.Remove(pointToRemove.Text);
                        points.Remove(pointToRemove);
                        RecalculateConnectionLine();
                    }
                }
                else if (selectedElement is TextBlock tb)
                {
                    var pointToRemove = points.FirstOrDefault(p => p.Text == tb);
                    if (pointToRemove != null)
                    {
                        TileCanvas.Children.Remove(pointToRemove.Ellipse);
                        points.Remove(pointToRemove);
                        RecalculateConnectionLine();
                    }
                }
                else if (selectedElement is Rectangle rect)
                {
                    var mapRect = mapRectangles.FirstOrDefault(r => r.Shape == rect);
                    if (mapRect != null)
                        mapRectangles.Remove(mapRect);
                }

                selectedElement = null;
                e.Handled = true;
            }
        }

        //combo box colors
        private void StrokeColorBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            var selected = (StrokeColorBox.SelectedItem as ComboBoxItem)?.Content.ToString();

            _strokeBrush = selected switch
            {
                "Red" => Brushes.Red,
                "Green" => Brushes.Green,
                "Blue" => Brushes.Blue,
                "Black" => Brushes.Black,
                "Orange" => Brushes.Orange,
                _ => Brushes.Red
            };
        }

        //rewind drawing steps
        private void LoadDawingStep(int step)
        {
            if (points.Count == 0) return;

            foreach (var pt in points)
            {
                TileCanvas.Children.Remove(pt.Ellipse);
                TileCanvas.Children.Remove(pt.Text);
            }

            connectionLine.Points.Clear();

            for (int i = 0; i < Math.Min(step, points.Count); i++)
            {
                var pt = points[i];

                if (!TileCanvas.Children.Contains(pt.Ellipse))
                    TileCanvas.Children.Add(pt.Ellipse);

                if (!TileCanvas.Children.Contains(pt.Text))
                    TileCanvas.Children.Add(pt.Text);

                connectionLine.Points.Add(pt.Position);
            }
        }

        //checking for close points => drawing only one point on one place
        private bool ArePointsClose(Point p1, Point p2, double threshold = 2.0)
        {
            return Math.Abs(p1.X - p2.X) < threshold && Math.Abs(p1.Y - p2.Y) < threshold;
        }

        //Exporting canvas into an image
        private void ExportCanvasToPng(Canvas canvas, string filePath)
        {
            int width = (int)canvas.ActualWidth;
            int height = (int)canvas.ActualHeight;
            int dpi = 96;

            if (width == 0 || height == 0)
            {
                Console.WriteLine("Canvas size is zero, export skipped.");
                return;
            }

            canvas.Measure(new Size(width, height));
            canvas.Arrange(new Rect(new Size(width, height)));
            canvas.UpdateLayout();

            RenderTargetBitmap rtb = new RenderTargetBitmap(width, height, dpi, dpi, PixelFormats.Pbgra32);

            var dv = new DrawingVisual();

            using (var dc = dv.RenderOpen())
            {
                dc.PushTransform(canvas.RenderTransform);

                var vb = new VisualBrush(canvas);
                dc.DrawRectangle(vb, null, new Rect(new Point(), new Size(width, height)));

                dc.Pop();
            }

            rtb.Render(dv);

            PngBitmapEncoder encoder = new PngBitmapEncoder();
            encoder.Frames.Add(BitmapFrame.Create(rtb));

            using (var stream = new FileStream(filePath, FileMode.Create))
            {
                encoder.Save(stream);
            }

            Console.WriteLine($"Export completed: {filePath}");
        }

        //moving objects with RMB
        private void TileCanvas_MouseRightButtonDown(object sender, MouseButtonEventArgs e)
        {
            var position = e.GetPosition(TileCanvas);
            var hit = VisualTreeHelper.HitTest(TileCanvas, position);
            if (hit == null) return;

            if (hit.VisualHit is Rectangle or Ellipse or TextBlock or Line)
            {
                selectedElement = hit.VisualHit as UIElement;
                mouseOffset = position;

                ShowPropertiesFor(selectedElement);
                TileCanvas.Cursor = Cursors.SizeAll;

                e.Handled = true;
            }
        }

        //mouse dragging
        private void TileCanvas_MouseMoveForDrag(object sender, MouseEventArgs e)
        {
            if (selectedElement == null || e.RightButton != MouseButtonState.Pressed) return;

            var currentPos = e.GetPosition(TileCanvas);
            var dx = currentPos.X - mouseOffset.X;
            var dy = currentPos.Y - mouseOffset.Y;

            if (selectedElement is FrameworkElement element)
            {
                double left = Canvas.GetLeft(element);
                double top = Canvas.GetTop(element);

                double newLeft = left + dx;
                double newTop = top + dy;

                Canvas.SetLeft(element, newLeft);
                Canvas.SetTop(element, newTop);

                if (selectedElement is TextBlock tb)
                {
                    var matchingPoint = points.FirstOrDefault(p => p.Text == tb);
                    if (matchingPoint != null)
                    {
                        var newPos = new Point(newLeft + 5, newTop + 10);
                        matchingPoint.Position = newPos;
                        RecalculateConnectionLine();

                        if (isRecording)
                        {
                            matchingPoint.MovementFrames.Add(new MovementFrame
                            {
                                Timestamp = DateTime.Now - recordingStartTime,
                                Position = newPos
                            });
                        }
                    }
                }

                mouseOffset = currentPos;
            }
        }

        //RMB release updater
        private void TileCanvas_MouseRightButtonUp(object sender, MouseButtonEventArgs e)
        {
            if (selectedElement is Rectangle rect)
            {
                Prop_Name.Text = (string)rect.Tag ?? "";
                Prop_Width.Text = rect.Width.ToString("F0");
                Prop_Height.Text = rect.Height.ToString("F0");
            }
            selectedElement = null;
            TileCanvas.Cursor = Cursors.Arrow;
        }

        //recalculating connection line between points after dragging or removing point(s)
        private void RecalculateConnectionLine()
        {
            connectionLine.Points.Clear();

            foreach (var pt in points)
            {
                connectionLine.Points.Add(pt.Position);
            }
        }

        //saving map into an XML file (lines, rectangles, points)
        private void SaveXML(string filePath)
        {
            try
            {
                var doc = new XDocument(
                    new XElement("MapRectangles",
                        mapRectangles.Select(r => new XElement("Rectangle",
                            new XAttribute("X", r.X),
                            new XAttribute("Y", r.Y),
                            new XAttribute("Width", r.Width),
                            new XAttribute("Height", r.Height),
                            new XAttribute("Fill", r.Fill.ToString()),
                            new XAttribute("Name", r.Name),
                            new XAttribute("Description", r.Description),
                            new XAttribute("Contains", r.ContainsSomething)
                        ))
                    )
                );
                doc.Save(filePath);
                Console.WriteLine("Saved to XML: " + filePath);
            }
            catch (Exception ex) 
            {
                Console.WriteLine("Error saving XML: " + ex.Message);
            }
        }

        //loading XML file
        private void LoadXML(string filePath)
        {
            if (!File.Exists(filePath))
            {
                MessageBox.Show("XML File not found");
                return; 
            }

            try
            {
                var doc = XDocument.Load(filePath);
                var rectangles = doc.Root.Elements("Rectangle");

                foreach (var elem in rectangles)
                {
                    double x = double.Parse(elem.Attribute("X")?.Value ?? "0");
                    double y = double.Parse(elem.Attribute("Y")?.Value ?? "0");
                    double width = double.Parse(elem.Attribute("Width")?.Value ?? "0");
                    double height = double.Parse(elem.Attribute("Height")?.Value ?? "0");
                    string fillStr = elem.Attribute("Fill")?.Value ?? "0";
                    string name = elem.Attribute("Name")?.Value ?? "0";
                    string desc = elem.Attribute("Description")?.Value ?? "0";
                    bool contains = bool.Parse(elem.Attribute("ContainsSomething")?.Value ?? "0");

                    BrushConverter converter = new BrushConverter();
                    Brush fill = (Brush)converter.ConvertFromString(fillStr);

                    var rect = new Rectangle
                    {
                        Width = width,
                        Height = height,
                        Fill = fill,
                        Stroke = Brushes.Black,
                        StrokeThickness = 1
                    };

                    Canvas.SetLeft(rect, x);
                    Canvas.SetTop(rect, y); 

                    TileCanvas.Children.Add(rect);

                    var mapRect = new MapRectangle(rect)    
                    {
                        X = x,
                        Y = y,
                        Width = width,
                        Height = height,
                        Fill = fill,
                        Name = name,
                        Description = desc,
                        ContainsSomething = contains
                    };

                    mapRectangles.Add(mapRect);
                }

                Console.WriteLine("Loaded from XML: " + filePath);
            }
            catch (Exception ex) 
            {
                Console.WriteLine("Error loading XML: " + ex.Message);
            }
        }

        //Snapping position for rectangles etc. (main calculation)
        private Point? GetSnapPosition(Point current)
        {
            foreach (var rect in mapRectangles) 
            {
                var element = rect.Shape;

                double x = Canvas.GetLeft(element);
                double y = Canvas.GetTop(element);
                double width = element.Width;
                double height = element.Height;

                var snapPoints = new List<Point>
                {
                    new Point(x, y),
                    new Point(x + width, y),
                    new Point(x, y + height),
                    new Point(x + width, y + height),
                    new Point(x + width / 2, y + height / 2)
                };

                foreach (var p in snapPoints)
                {
                    if (Math.Abs(p.X - current.X) < SnapThreshold &&
                        Math.Abs(p.Y - current.Y) < SnapThreshold)
                    {
                        return p;
                    }
                }
            }

            return null;
        }

        //Undo and redo (for the key button function via. above)
        private void AddUndoRedo(Action undo, Action redo)
        {
            undoStack.Push(undo);
            redoStack.Clear();
        }

        private void Undo()
        {
            if (undoStack.Count > 0)
            {
                var action = undoStack.Pop();
                action.Invoke();
                redoStack.Push(action);
            }
        }

        private void Redo()
        {
            if (redoStack.Count > 0)
            {
                var action = redoStack.Pop();
                action.Invoke();
                undoStack.Push(action);
            }
        }

        //Playback timer ticks
        private void PlaybackTimer_Tick(object? sender, EventArgs e)
        {
            playbackElapsedTime = DateTime.Now - playbackStartTime;

            foreach (var pt in points)
            {
                if (pt.MovementFrames.Count == 0) continue;

                var nextFrame = pt.MovementFrames
                    .FirstOrDefault(f => f.Timestamp > playbackElapsedTime);

                if (nextFrame == null)
                {
                    var last = pt.MovementFrames.Last();
                    UpdatePointPosition(pt, last.Position);
                    continue;
                }

                var prevFrame = pt.MovementFrames
                    .LastOrDefault(f => f.Timestamp <= playbackElapsedTime);

                if (prevFrame != null)
                {
                    double progress = (playbackElapsedTime - prevFrame.Timestamp).TotalMilliseconds /
                                      (nextFrame.Timestamp - prevFrame.Timestamp).TotalMilliseconds;

                    var interpolated = new Point(
                        Lerp(prevFrame.Position.X, nextFrame.Position.X, progress),
                        Lerp(prevFrame.Position.Y, nextFrame.Position.Y, progress)
                    );

                    UpdatePointPosition(pt, interpolated);
                }
            }

            if (points.All(p => playbackElapsedTime > p.MovementFrames.LastOrDefault()?.Timestamp))
            {
                playbackTimer.Stop();
                isPlaying = false;
            }
        }

        //start recording method
        private void StartRecording()
        {
            isRecording = true;
            recordingStartTime = DateTime.Now;
            foreach (var pt in points)
                pt.MovementFrames.Clear();
        }

        private void StopRecording()
        {
            isRecording = false;
        }

        private double Lerp(double a, double b, double t)
        {
            return a + (b - a) * t;
        }

        private void UpdatePointPosition(MapPoint pt, Point pos)
        {
            Canvas.SetLeft(pt.Ellipse, pos.X - pt.Ellipse.Width / 2);
            Canvas.SetTop(pt.Ellipse, pos.Y - pt.Ellipse.Height / 2);

            Canvas.SetLeft(pt.Text, pos.X + 5);
            Canvas.SetTop(pt.Text, pos.Y - 10);

            pt.Position = pos;
            RecalculateConnectionLine();
        }

        //V2X Listener 
        private async Task StartV2XListenerAsync(string portName, int baudRate)
        {
            try
            {
                serialPort = new SerialPort(portName, baudRate);
                serialPort.NewLine = "\r\n";
                serialPort.Open();

                while (serialPort.IsOpen)
                {
                    string rawXml = await ReadLineAsync(serialPort);
                    if (string.IsNullOrWhiteSpace(rawXml)) continue;

                    try
                    {
                        var msg = V2XMessageParser.ParseV2XMessage(rawXml);

                        if (msg.MessageType == "CAM")
                        {
                            if (IsValidCamMessage(rawXml))
                                IncrementCamOkCount();
                            else
                                IncrementCamErrorCount();
                        }

                        Console.WriteLine($"[{msg.Timestamp:HH:mm:ss}] {msg.MessageType} ID={msg.MessageID}");

                        Dispatcher.Invoke(() => HandleV2XMessage(msg, rawXml));
                    }
                    catch (Exception ex)
                    {
                        IncrementCamErrorCount();
                        Console.WriteLine($"Error parsing message: {ex.Message}");
                    }
                }
            }
            catch (Exception ex)
            {
                Dispatcher.Invoke(() =>
                    MessageBox.Show($"Serial Port Listener Error: {ex.Message}")
                );
            }
        }

        private Task<string> ReadLineAsync(SerialPort port)
        {
            return Task.Run(() => port.ReadLine());
        }

        //Handling V2X messages
        private void HandleV2XMessage(V2XMessage msg, string rawXml)
        {
            if (msg.MessageType == "CAM")
            {
                if (IsValidCamMessage(rawXml))
                {
                    IncrementCamOkCount();
                }

                else
                {
                    IncrementCamErrorCount();
                }
            }


            Dispatcher.Invoke(() =>
            {
                if (!activeVehicles.TryGetValue(msg.VehicleID, out var vehicle))
                {
                    var ellipse = new Ellipse
                    {
                        Width = 10,
                        Height = 10,
                        Fill = Brushes.Green
                    };

                    var text = new TextBlock
                    {
                        Text = msg.VehicleID,
                        Foreground = Brushes.Black,
                        FontWeight = FontWeights.Bold
                    };

                    TileCanvas.Children.Add(ellipse);
                    TileCanvas.Children.Add(text);

                    vehicle = new MapPoint
                    {
                        Label = msg.VehicleID,
                        Ellipse = ellipse,
                        Text = text
                    };

                    activeVehicles[msg.VehicleID] = vehicle;
                }

                var (x, y) = ConvertLatLonToCanvasXY(msg.Latitude, msg.Longitude);

                Canvas.SetLeft(vehicle.Ellipse, x - 5);
                Canvas.SetTop(vehicle.Ellipse, y - 5);
                Canvas.SetLeft(vehicle.Text, x + 5);
                Canvas.SetTop(vehicle.Text, y - 10);

                vehicle.Position = new Point(x, y);
            });
        }

        
        private void DrawSrvPoint(SRVMessage msg)
        {
            if (msg == null) return;

            var (canvasX, canvasY) = ConvertLatLonToCanvasXY(msg.Latitude, msg.Longitude);

            Ellipse point = new Ellipse
            {
                Width = 10,
                Height = 10,
                Fill = Brushes.Red,
                Stroke = Brushes.Black,
                StrokeThickness = 1,
                Tag = msg.LogicalId
            };

            Canvas.SetLeft(point, canvasX - point.Width / 2);
            Canvas.SetTop(point, canvasY - point.Height / 2);

            TileCanvas.Children.Add(point);
        }

