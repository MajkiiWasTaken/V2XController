        private async void Connect_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                string portName = PortTB.Text.Trim();
                if (!int.TryParse(BaudrateTB.Text.Trim(), out int baudRate))
                {
                    MessageBox.Show("Enter valid numeric baudrate");
                    return;
                }

                if (serialPort == null || !serialPort.IsOpen)
                {
                    await StartV2XListenerAsync(portName, baudRate);
                    MessageBox.Show($"Connected on {portName} of speed {baudRate} bps.");
                }
                else
                {
                    MessageBox.Show("Port already open.");
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error connecting: " + ex.Message);
            }
        }



        private void Prop_Width_TextChanged(object sender, TextChangedEventArgs e)
        {
            if (selectedRectangle == null) return;

            if (Prop_Width.IsFocused && double.TryParse(Prop_Width.Text, out double newWidth))
            {
                selectedRectangle.Width = newWidth;
                var mapRect = mapRectangles.FirstOrDefault(r => r.Shape == selectedRectangle);
                if (mapRect != null)
                    mapRect.Width = newWidth;
            }
        }

        private void Prop_Height_TextChanged(object sender, TextChangedEventArgs e)
        {
            if (selectedRectangle == null) return;

            if (Prop_Height.IsFocused && double.TryParse(Prop_Height.Text, out double newHeight))
            {
                selectedRectangle.Height = newHeight;
                var mapRect = mapRectangles.FirstOrDefault(r => r.Shape == selectedRectangle);
                if (mapRect != null)
                    mapRect.Height = newHeight;
            }
        }

