        private void IncrementCamOkCount()
        {
            camOkCount++;

            Dispatcher.Invoke(() =>
                CamOkLabel.Content = $"CAM OK: {camOkCount}");
        } 

        private void IncrementCamErrorCount()
        {
            camErrorCount++;

            Dispatcher.Invoke(() =>
            {
                CamErrorLabel.Content = $"CAM Errors: {camErrorCount}";
            });
        }

        public static bool IsValidCamMessage(string rawXml)
        {
            try
            {
                var xmlDoc = new XmlDocument();
                xmlDoc.LoadXml(rawXml);

                var crcNode = xmlDoc.SelectSingleNode("//crc");
                if (crcNode == null) return false;

                string providedCrc = crcNode.InnerText.Trim();

                crcNode.ParentNode.RemoveChild(crcNode);

                string xmlWithoutCrc = xmlDoc.OuterXml;

                ushort computed = ComputeCRC(xmlWithoutCrc);

                return providedCrc == computed.ToString();
            }
            catch
            {
                return false;
            }
        }

        //COMPUTING CRC
        public static ushort ComputeCRC(string data)
        {
            ushort crc = 0;
            ushort polynomial = 0x8005;

            byte[] bytes = Encoding.UTF8.GetBytes(data);

            foreach (byte b in bytes)
            {
                crc ^= (ushort)(b << 8);

                for (int i = 0; i < 8; i++)
                {
                    if ((crc & 0x8000) != 0)
                        crc = (ushort)((crc << 1) ^ polynomial);
                    else
                        crc <<= 1;
                }
            }

            return crc;
        }

        private void SelectElement(UIElement element)
        {
            DeselectElement();

            selectedElement = element;

            if (element is Rectangle rect)
            {
                selectedRectangle = rect;
                rect.Stroke = Brushes.Gold;

                Prop_Name.Text = (string)rect.Tag ?? "";
                Prop_Width.Text = rect.Width.ToString("F0");
                Prop_Height.Text = rect.Height.ToString("F0");

                PropertiesPanel.Visibility = Visibility.Visible;
                UpdatePropertiesPanel(rect);
            }
            else
            {
                selectedRectangle = null;
                PropertiesPanel.Visibility = Visibility.Collapsed;
            }
        }

        private void DeselectElement()
        {
            if (selectedElement is Shape shape)
                shape.Stroke = Brushes.Black;

            selectedElement = null;
            selectedRectangle = null;
            PropertiesPanel.Visibility = Visibility.Collapsed;
        }


        //properties panel update
        private void UpdatePropertiesPanel(Rectangle rect)
        {
             if (rect == null)
             {
                 ClearPropertiesPanel();
                 return;
             }

             selectedRectangle = rect;

             Prop_Name.Text = (string)rect.Tag ?? "";

             Prop_Width.Text = rect.Width.ToString();
             Prop_Height.Text = rect.Height.ToString();

             PropertiesPanel.Visibility = Visibility.Visible;
        }

        private void ClearPropertiesPanel()
        {
            selectedRectangle = null;
            Prop_Name.Text = "";
            Prop_Width.Text = "";
            Prop_Height.Text = "";
            PropertiesPanel.Visibility = Visibility.Collapsed;
        }

        private void Prop_Width_KeyDown(object sender, KeyEventArgs e)
        {
