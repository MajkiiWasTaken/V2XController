            Dispatcher.Invoke(() =>
            {
                CamErrorLabel.Content = $"CAM Errors: {camErrorCount}";
            });
        }

        private void IncrementSrvOkCount()
        {
            srvOkCount++;

            Dispatcher.Invoke(() =>
