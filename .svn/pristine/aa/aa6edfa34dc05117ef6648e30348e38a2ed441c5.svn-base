        //Methods for rotating rectangles around their base center
        private void RotateRectangleAroundBaseCenter(Rectangle rect, double angleDegrees, Point startPointCanvas, double currentWidth)
        {
            if (rect == null) return;

            double rectLeft = Canvas.GetLeft(rect);
            double rectTop = Canvas.GetTop(rect);

            double baseCenterX = startPointCanvas.X + currentWidth / 2.0;
            double baseCenterY = startPointCanvas.Y;

            double localX = baseCenterX - rectLeft;
            double localY = baseCenterY - rectTop;

            var transformGroup = new TransformGroup();
            transformGroup.Children.Add(new TranslateTransform(-localX, -localY));
            transformGroup.Children.Add(new RotateTransform(angleDegrees));
            transformGroup.Children.Add(new TranslateTransform(localX, localY));

            rect.RenderTransform = transformGroup;
        }

        private double LonToTileX(double lon, int zoom)
        {
            return (lon + 180.0) / 360.0 * (1 << zoom);
        }

        private double LatToTileY(double lat, int zoom)
        {
            double latRad = lat * Math.PI / 180.0;
            return (1.0 - Math.Log(Math.Tan(latRad) + 1.0 / Math.Cos(latRad)) / Math.PI) / 2.0 * (1 << zoom);
        }

        private double TileXToLon(double x, int zoom)
        {
            return x / Math.Pow(2, zoom) * 360.0 - 180.0;
        }

        private double TileYToLat(double y, int zoom)
        {
            double n = Math.PI - (2.0 * Math.PI * y) / Math.Pow(2, zoom);
            return 180.0 / Math.PI * Math.Atan(0.5 * (Math.Exp(n) - Math.Exp(-n)));
        }

        private Point CanvasPixelsToLatLon(Point pixelPoint, double centerLat, double centerLon, int zoom)
        {
            double centerTileX = LonToTileX(centerLon, zoom);
            double centerTileY = LatToTileY(centerLat, zoom);

            double leftTopTileX = centerTileX - 1;
            double leftTopTileY = centerTileY - 1;

            double relativeTileX = pixelPoint.X / TilePixelSize;
            double relativeTileY = pixelPoint.Y / TilePixelSize;

            double tileX = leftTopTileX + relativeTileX;
            double tileY = leftTopTileY + relativeTileY;

            float lon = (float)TileXToLon(tileX, zoom);
            float lat = (float)TileYToLat(tileY, zoom);

            return new Point(lon, lat);
        }

        private DrawPointF GetBaseCenterLatLon(WinRect rect, WinPoint startPoint, double centerLat, double centerLon, int zoom)
        {
            double baseCenterX = startPoint.X + rect.Width / 2.0;
            double baseCenterY = startPoint.Y + rect.Height;

            var baseCenterPoint = new WinPoint(baseCenterX, baseCenterY);
            var latlon = CanvasPixelsToLatLon(baseCenterPoint, centerLat, centerLon, zoom);

            return new DrawPointF((float)latlon.X, (float)latlon.Y);
        }

        private Point LatLonToCanvasPixels(double lat, double lon, double centerLat, double centerLon, int zoom)
        {
            double centerTileX = LonToTileX(centerLon, zoom);
            double centerTileY = LatToTileY(centerLat, zoom);

            double leftTopTileX = centerTileX - 1;
            double leftTopTileY = centerTileY - 1;

            double tileX = LonToTileX(lon, zoom);
            double tileY = LatToTileY(lat, zoom);

            double relativeTileX = tileX - leftTopTileX;
            double relativeTileY = tileY - leftTopTileY;

            double pixelX = relativeTileX * TilePixelSize;
            double pixelY = relativeTileY * TilePixelSize;

            return new Point(pixelX, pixelY);
        }




